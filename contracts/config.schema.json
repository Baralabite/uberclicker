{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uberclicker.com/contracts/config.schema.json",
  "title": "UberClicker readable configuration v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "role",
    "activeProfile",
    "profiles",
    "wifi",
    "radio",
    "peers",
    "activePeer"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "role": {
      "enum": [
        "tx",
        "rx"
      ]
    },
    "activeProfile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "previous",
          "next"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "previous": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/action"
            }
          },
          "next": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/action"
            }
          }
        }
      }
    },
    "wifi": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ssid",
          "configured"
        ],
        "properties": {
          "ssid": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1
          },
          "configured": {
            "type": "boolean"
          }
        }
      }
    },
    "radio": {
      "enum": [
        "balanced",
        "long_range"
      ]
    },
    "peers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "pairId",
          "name",
          "adminAuthorized"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "pairId": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "adminAuthorized": {
            "type": "boolean"
          }
        }
      }
    },
    "activePeer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "rx"
          }
        }
      },
      "then": {
        "properties": {
          "peers": {
            "maxItems": 1,
            "type": "array"
          }
        }
      }
    }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "enabled",
        "host",
        "port",
        "key",
        "modifiers",
        "midi",
        "osc",
        "payload"
      ],
      "properties": {
        "type": {
          "enum": [
            "lora",
            "ble_keyboard",
            "ble_midi",
            "osc_udp",
            "udp",
            "tcp",
            "cloud"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9.-]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "key": {
          "type": "integer",
          "minimum": 0,
          "maximum": 101
        },
        "modifiers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "midi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "channel",
            "number",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "note",
                "cc",
                "program"
              ]
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "number": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          }
        },
        "osc": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]{0,63}$"
        },
        "payload": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
