{
  "$schema": "../cloud/node_modules/wrangler/config-schema.json",
  "name": "uberclicker-website",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "account_id": "ecb7d7f0a38ffceb8ad7f96c022b43f2",
  "workers_dev": true,
  "routes": [{ "pattern": "uberclicker.com/*", "zone_name": "uberclicker.com" }, { "pattern": "www.uberclicker.com/*", "zone_name": "uberclicker.com" }],
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": ["/app", "/app/*"] },
  "observability": { "enabled": false }
}
