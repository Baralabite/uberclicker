{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UberClicker Companion",
  "version": "0.1.0",
  "identifier": "com.uberclicker.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UberClicker Companion",
        "width": 760,
        "height": 780,
        "minWidth": 540,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.uberclicker.com wss://api.uberclicker.com; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Receive UberClicker Cloud clicks as keyboard and OSC actions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
